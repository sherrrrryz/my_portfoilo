# Copy to .env.local for local dev, and set the same keys on Vercel
# (Project → Settings → Environment Variables) for production.
#
# Only the contact form needs env at all. Without RESEND_API_KEY the form
# still renders and still offers its "or write to me directly" mailto, but
# POST /api/send-email answers 500 and the visitor sees the failure line.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives contact-form mail.
# Optional; defaults to sherrrryz@outlook.com.
CONTACT_TO=

# Sender address. Optional; defaults to Resend's shared
# "Portfolio Contact <onboarding@resend.dev>".
#
# IMPORTANT: that shared sender may ONLY deliver to the address the Resend
# account itself is registered under. To deliver anywhere else (including
# sherrrryz@outlook.com) you must verify a domain at
# https://resend.com/domains and set this to an address on it, e.g.
#   CONTACT_FROM="Portfolio Contact <hello@xueyizhou.xyz>"
CONTACT_FROM=
